{
  "name": "koppajs-vscode-extension",
  "displayName": "KoppaJS VS Code Extension",
  "description": "VS Code editing support for KoppaJS .kpa files: grammar, completions, and structural diagnostics.",
  "keywords": [
    "koppa",
    "koppajs",
    "koppa.js",
    "frontend",
    "framework",
    "ui-framework",
    "typescript",
    "vite",
    "reactivity",
    "single-file-components",
    "modular",
    "lightweight",
    "high-performance",
    "web-development",
    "javascript"
  ],
  "author": "Bastian Bensch",
  "license": "Apache-2.0",
  "homepage": "https://koppajs.org",
  "publisher": "koppajs",
  "version": "0.0.2",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/koppajs/koppajs-vscode-extension"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:kpa"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "kpa",
        "extensions": [
          ".kpa"
        ],
        "aliases": [
          "KPA",
          "kpa"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "kpa",
        "scopeName": "source.kpa",
        "path": "./syntaxes/kpa.tmLanguage.json"
      }
    ],
    "embeddedLanguages": {
      "text.html.basic": "html",
      "source.js": "javascript",
      "source.css": "css",
      "source.ts": "typescript",
      "source.sass": "sass",
      "source.scss": "scss"
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "compile-tests": "tsc -p tsconfig.test.json",
    "watch-tests": "tsc -p tsconfig.test.json -w",
    "lint": "eslint . --ext .ts,.js,.cjs,.mjs",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pretest:integration": "npm run compile-tests && npm run compile",
    "test:integration": "vscode-test",
    "test": "npm run test:unit && npm run test:integration",
    "test:run": "npm run test",
    "check": "npm run lint && npm run typecheck && npm run test",
    "validate": "npm run format:check && npm run check",
    "prepare": "husky",
    "dump:ai": "node scripts/project-dump.mjs"
  },
  "lint-staged": {
    "*.{ts,js,cjs,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^22.19.15",
    "@types/vscode": "^1.82.0",
    "@typescript-eslint/eslint-plugin": "^7.4.0",
    "@typescript-eslint/parser": "^7.4.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^8.57.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "prettier": "^3.5.3",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "vitest": "^3.2.4",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4"
  }
}
